{
  "name": "open-platform",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.12.0 <23"
  },
  "scripts": {
    "dev:web": "pnpm --filter @open-platform/web dev",
    "typecheck": "pnpm --filter @open-platform/web typecheck",
    "build:web": "pnpm generate:public-api-docs && pnpm --filter @open-platform/web build",
    "test:web": "pnpm --filter @open-platform/web test",
    "generate:api": "pnpm --filter @open-platform/web generate:api",
    "validate:openapi": "redocly lint contracts/openapi/console-v1.yaml contracts/openapi/openapi-v1.yaml contracts/openapi/sandbox-v1.yaml",
    "validate:public-api": "pnpm generate:public-api-docs && node scripts/validate-public-api.mjs",
    "generate:public-api-docs": "node scripts/generate-public-api-docs.mjs"
  },
  "devDependencies": {
    "@redocly/cli": "2.20.0"
  }
}
